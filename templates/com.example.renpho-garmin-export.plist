<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.renpho-garmin-export</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/PATH/TO/renpho-garmin-sync/run_export.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/PATH/TO/renpho-garmin-sync</string>

    <!-- Run weekly on Sundays at 9:30 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/PATH/TO/renpho-garmin-sync/launchd-export.out.log</string>

    <key>StandardErrorPath</key>
    <string>/PATH/TO/renpho-garmin-sync/launchd-export.err.log</string>
</dict>
</plist>

# Renpho Health credentials
RENPHO_EMAIL=your_email@example.com
RENPHO_PASSWORD=your_password_here

# Optional: Target Renpho user ID (useful when authenticating with a secondary
# account to avoid evicting the session on your phone's mobile app)
# RENPHO_TARGET_USER_ID=1234567890123456789

# Optional: Garmin Connect token directory (defaults to ~/.garminconnect)
# GARMINTOKENS=~/.garminconnect
